// ============================================================================
// Общий модуль: ВыгрузкаДляСправочника
//
// Выгрузка данных 1С:УПП для Django-справочника номенклатуры (ADR-009,
// ADR-014 — assets/adr-spravochnik-nomenklatury.md).
//
// Формат выходных файлов и все имена полей ЗАФИКСИРОВАНЫ контрактом на
// стороне Django: см. докстринг catalog/management/commands/import_1c.py.
// Меняя структуру здесь — синхронизируйте обе стороны.
//
// Свойства модуля в конфигураторе:
//   Сервер = Истина
//   Вызов сервера = Истина
//   (клиентские свойства не нужны — модуль вызывается только регламентными
//   заданиями на сервере)
//
// Подключение регламентных заданий — см. onec_export/README.md.
// ============================================================================

// Путь к папке выгрузки. Общая с Django (settings.IMPORT_DIR), см. ADR-020
// (1С и Django на одной машине — путь локальный, не сетевой).
// УКАЖИТЕ РЕАЛЬНЫЙ ПУТЬ перед использованием на проде.
Функция ПутьКПапкеВыгрузки() Экспорт
	Возврат "D:\spravochnik\import\";
КонецФункции

#Область ПубличныйИнтерфейс

// Регламентное задание: раз в сутки (ADR-009, ~03:00).
Процедура ВыгрузитьНоменклатуру() Экспорт

	Данные = New Структура;
	Данные.Вставить("kinds", ПолучитьВидыНоменклатуры());
	Данные.Вставить("folders", ПолучитьПапки());
	Данные.Вставить("nomenclature", ПолучитьНоменклатуру());

	ЗаписатьJSONАтомарно(Данные, "nomenclature.json");

КонецПроцедуры

// Регламентное задание: каждые 3-4 часа в рабочее время (ADR-009).
Процедура ВыгрузитьОстатки() Экспорт

	Данные = New Структура;
	Данные.Вставить("warehouses", ПолучитьСклады());
	Данные.Вставить("balances", ПолучитьОстаткиИРезерв());

	ЗаписатьJSONАтомарно(Данные, "stock.json");

КонецПроцедуры

#КонецОбласти

#Область ВыборкаДанных

Функция ПолучитьВидыНоменклатуры()

	Запрос = New Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Вид.Код КАК Код,
	|	Вид.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Вид";

	Результат = New Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = New Структура;
		Строка.Вставить("code", СокрЛП(Выборка.Код));
		Строка.Вставить("name", Выборка.Наименование);
		Результат.Добавить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Папки — не отдельный справочник 1С: элементы Справочник.Номенклатура
// с ЭтоГруппа = Истина (ADR-003, подтверждено в ADR-014).
Функция ПолучитьПапки()

	Запрос = New Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Гр.Код КАК Код,
	|	Гр.Наименование КАК Наименование,
	|	Гр.Родитель.Код КАК КодРодителя
	|ИЗ
	|	Справочник.Номенклатура КАК Гр
	|ГДЕ
	|	Гр.ЭтоГруппа";

	Результат = New Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = New Структура;
		Строка.Вставить("code", СокрЛП(Выборка.Код));
		Строка.Вставить("name", Выборка.Наименование);
		Если ПустаяСтрока(СокрЛП(Выборка.КодРодителя)) Тогда
			Строка.Вставить("parent_code", Неопределено);
		Иначе
			Строка.Вставить("parent_code", СокрЛП(Выборка.КодРодителя));
		КонецЕсли;
		Результат.Добавить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// База — запрос "выбор номенклатуры.sel" (ADR-014), расширенный полем
// ПометкаУдаления (нужна для is_active, ADR-009: 1С выгружает все позиции,
// включая помеченные на удаление).
Функция ПолучитьНоменклатуру()

	Запрос = New Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ном.Код КАК Код,
	|	Ном.Наименование КАК Наименование,
	|	Ном.Артикул КАК Артикул,
	|	Ном.БазоваяЕдиницаИзмерения.Наименование КАК ЕдиницаИзмерения,
	|	Ном.ВидНоменклатуры.Код КАК КодВида,
	|	Ном.Родитель.Код КАК КодПапки,
	|	Ном.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	НЕ Ном.ЭтоГруппа
	|УПОРЯДОЧИТЬ ПО
	|	Ном.Код";

	Результат = New Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = New Структура;
		Строка.Вставить("code", СокрЛП(Выборка.Код));
		Строка.Вставить("name", Выборка.Наименование);
		Строка.Вставить("article", Выборка.Артикул);
		Строка.Вставить("base_unit", Выборка.ЕдиницаИзмерения);

		Если ПустаяСтрока(СокрЛП(Выборка.КодВида)) Тогда
			Строка.Вставить("kind_code", Неопределено);
		Иначе
			Строка.Вставить("kind_code", СокрЛП(Выборка.КодВида));
		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(Выборка.КодПапки)) Тогда
			Строка.Вставить("folder_code", Неопределено);
		Иначе
			Строка.Вставить("folder_code", СокрЛП(Выборка.КодПапки));
		КонецЕсли;

		Строка.Вставить("is_active", НЕ Выборка.ПометкаУдаления);

		Результат.Добавить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьСклады()

	Запрос = New Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Скл.Код КАК Код,
	|	Скл.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Склады КАК Скл
	|ГДЕ
	|	НЕ Скл.ЭтоГруппа"; // если Склады не иерархический справочник — уберите ГДЕ

	Результат = New Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = New Структура;
		Строка.Вставить("code", СокрЛП(Выборка.Код));
		Строка.Вставить("name", Выборка.Наименование);
		Результат.Добавить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Запрос валидирован в ADR-014 в консоли запросов на копии UPP_PL_VLAD:
// РегистрНакопления.ТоварыНаСкладах (остаток) ПОЛНОЕ СОЕДИНЕНИЕ
// РегистрНакопления.ТоварыВРезервеНаСкладах (резерв), группировка по
// (Номенклатура, Склад). Имя регистра резерва — проверьте на своей базе,
// оно варьируется между конфигурациями УПП (см. ADR-014).
Функция ПолучитьОстаткиИРезерв()

	Запрос = New Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Свод.Номенклатура.Код КАК КодНоменклатуры,
	|	Свод.Склад.Код КАК КодСклада,
	|	Свод.Остаток КАК Остаток,
	|	Свод.ВРезерве КАК ВРезерве
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕСТЬNULL(Остатки.Номенклатура, Резерв.Номенклатура) КАК Номенклатура,
	|		ЕСТЬNULL(Остатки.Склад, Резерв.Склад) КАК Склад,
	|		ЕСТЬNULL(Остатки.Количество, 0) КАК Остаток,
	|		ЕСТЬNULL(Резерв.Количество, 0) КАК ВРезерве
	|	ИЗ
	|		(ВЫБРАТЬ
	|			Т.Номенклатура КАК Номенклатура,
	|			Т.Склад КАК Склад,
	|			СУММА(Т.КоличествоОстаток) КАК Количество
	|		ИЗ
	|			РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура.ЭтоГруппа = ЛОЖЬ) КАК Т
	|		СГРУППИРОВАТЬ ПО
	|			Т.Номенклатура, Т.Склад) КАК Остатки
	|
	|		ПОЛНОЕ СОЕДИНЕНИЕ
	|
	|		(ВЫБРАТЬ
	|			Р.Номенклатура КАК Номенклатура,
	|			Р.Склад КАК Склад,
	|			СУММА(Р.КоличествоОстаток) КАК Количество
	|		ИЗ
	|			РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Номенклатура.ЭтоГруппа = ЛОЖЬ) КАК Р
	|		СГРУППИРОВАТЬ ПО
	|			Р.Номенклатура, Р.Склад) КАК Резерв
	|
	|		ПО Остатки.Номенклатура = Резерв.Номенклатура
	|			И Остатки.Склад = Резерв.Склад) КАК Свод
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодНоменклатуры,
	|	КодСклада";

	Результат = New Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = New Структура;
		Строка.Вставить("nomenclature_code", СокрЛП(Выборка.КодНоменклатуры));
		Строка.Вставить("warehouse_code", СокрЛП(Выборка.КодСклада));
		Строка.Вставить("qty", ЧислоJSON(Выборка.Остаток));
		Строка.Вставить("reserved", ЧислоJSON(Выборка.ВРезерве));
		Результат.Добавить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Служебное

// Строкой с точкой как разделителем дробной части — иначе русская
// локаль отдаст запятую, и Decimal(str(value)) на стороне Django упадёт
// или тихо потеряет дробную часть.
Функция ЧислоJSON(Число)
	Возврат Формат(Число, "ЧДЦ=3; ЧРД=.; ЧГ=0");
КонецФункции

// Пишет ДанныеJSON во ВременноеИмяФайла (<ИмяФайла>.tmp), затем
// переименовывает в финальное имя — атомарная замена в пределах одного
// тома (ADR-009). Django не видит промежуточное состояние: либо файла
// ещё нет под финальным именем, либо он уже целиком записан.
Процедура ЗаписатьJSONАтомарно(ДанныеJSON, ИмяФайла)

	ПапкаВыгрузки = ПутьКПапкеВыгрузки();
	Если Прав(ПапкаВыгрузки, 1) <> "\" Тогда
		ПапкаВыгрузки = ПапкаВыгрузки + "\";
	КонецЕсли;

	ИтоговыйПуть = ПапкаВыгрузки + ИмяФайла;
	ВременныйПуть = ИтоговыйПуть + ".tmp";

	Запись = New ЗаписьJSON;
	Запись.ОткрытьФайл(ВременныйПуть, "UTF-8", Ложь); // Ложь = без BOM
	Запись.ЗаписатьНеопределенноеЗначениеКакNull = Истина;
	ЗаписатьJSON(Запись, ДанныеJSON);
	Запись.Закрыть();

	ФайлВременный = New Файл(ВременныйПуть);
	Если НЕ ФайлВременный.Существует() Тогда
		ВызватьИсключение "Не удалось создать временный файл выгрузки: " + ВременныйПуть;
	КонецЕсли;

	ФайлИтоговый = New Файл(ИтоговыйПуть);
	Если ФайлИтоговый.Существует() Тогда
		УдалитьФайлы(ИтоговыйПуть);
	КонецЕсли;

	ФайлВременный.Переименовать(ИтоговыйПуть);

КонецПроцедуры

#КонецОбласти

# Шаблон переменных окружения для прод-запуска справочника номенклатуры.
# Скопировать на сервере в файл вне репозитория (например C:\spravochnik\prod.env),
# заполнить значения и передать путь к нему в deploy\install_service.ps1
# параметром -EnvFile. В git этот заполненный файл не коммитить.
#
# Формат: KEY=VALUE, по одной паре на строку, без кавычек и без "export".
# Пустые строки и строки, начинающиеся с #, игнорируются.

# --- Django ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# В проде строго False.
DJANGO_DEBUG=False
# Через запятую: hostname сервера, его FQDN и IP, по которым будут открывать сайт.
DJANGO_ALLOWED_HOSTS=spravochnik,spravochnik.example.local,10.0.0.10
# Часовой пояс предприятия (ADR-009 — влияет на время ночного импорта).
DJANGO_TIME_ZONE=Europe/Moscow

# --- PostgreSQL (ADR-001) ---
DATABASE_NAME=spravochnik
DATABASE_USER=spravochnik
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- Импорт из 1С (ADR-009) ---
# Папка, куда обработка-выгрузка 1С кладёт JSON-файлы. На MVP это локальная
# папка на этой же машине (ADR-020); при переносе 1С на другую машину —
# UNC-путь к сетевой шаре, к которой у учётной записи службы импорта есть
# доступ на чтение.
IMPORT_DIR=C:\spravochnik\import
